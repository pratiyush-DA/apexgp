# ApexGraph Environment Configuration Template
# Copy to .env and configure as needed.

# Application Server
APEX_ENV=development
APEX_HOST=127.0.0.1
APEX_PORT=8000
APEX_DEBUG=true

# Database Configuration
# Default: Local zero-setup SQLite database file.
# For production PostgreSQL: postgresql+psycopg2://user:password@localhost:5432/apexgraph
DATABASE_URL=sqlite:///./data/apexgraph.db

# Workspace & Storage Configuration
APEX_DATA_DIR=./data
APEX_REPOS_DIR=./data/repositories

# Indexing Resource Limits
MAX_FILE_SIZE_BYTES=2097152       # 2 MB limit per source file
MAX_REPO_SIZE_BYTES=524288000     # 500 MB limit per repository
INDEXING_TIMEOUT_SECONDS=180      # 3 minutes maximum indexing duration

# Graph Query Safety Bounds
MAX_GRAPH_TRAVERSAL_DEPTH=10
MAX_GRAPH_NEIGHBORS=200

# Security & Network Settings
ALLOW_LOCAL_REPOS=true
SSRF_PROTECTION_ENABLED=true
SECRET_REDACTION_ENABLED=true
